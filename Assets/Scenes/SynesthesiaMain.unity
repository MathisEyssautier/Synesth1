  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n<align=\"center\">Merci d'avoir parcouru cette histoire avec nous
    !</align=\"center\">\n\n<align=\"center\"><b><size=120%>Equipe :</b></size=120%></align=\"center\">\n\n<b>Vanina
    Meganck :</b>\n<size=80%>Narrative Design - Mod\xE9lisation 3D - Direction Artistique</size=80%>\n\n<b>Mathis
    Eyssautier :</b>\n<size=80%>D\xE9veloppement - Composition Musicale - Sound Design</size=80%>\n\n<b>Ethel
    Serer :</b>\n<size=80%>Game Design - Level Design - 3D Art</size=80%>\n\n<b>Chlo\xE9
    Gommard :</b> \n<size=80%>Creative Technologist - Tech / 2D Art - Narrative Design</size=80%>
    \n\n\n \n<align=\"center\">Nous tenions \xE0 remercier les diff\xE9rentes institutions
    et personnes qui ont permis \xE0 ce jeu de voir le jour :</align=\"center\">
    \n\n<size=80%>Les Gobelins et le CNAM, en particulier nos enseignants pour leur
    encadrement.\n\n\n\n\n\nToutes les personnes qui ont test\xE9 le jeu et partag\xE9
    leur retours.\n\nSetareh, Nawal, Dagmara, Kenza, Paola, Juliette, Salom\xE9 pour
    leurs t\xE9moignages qui nous ont inspir\xE9s Na\xEFa.</size=80%>\n\n\n<align=\"center\"><size=60%>\xA9
    IDE 2026 - Glimpse Interactive\nTous droits r\xE9serv\xE9s.</size=60%></align=\"center\">"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1d488c4b6c788d94396752c44e82216d, type: 2}
