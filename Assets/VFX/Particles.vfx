  m_Script: {fileID: 11500000, guid: d01270efd3285ea4a9d6c555cb0a8027, type: 3}
  m_Name: VFXUI
  m_EditorClassIdentifier: 
  groupInfos:
  - title: Sample Mesh Operator
    position:
      serializedVersion: 2
      x: -1370.4421
      y: 54.3284
      width: 1231
      height: 537
    contents:
    - model: {fileID: 8926484042661615608}
      id: 0
      isStickyNote: 0
    - model: {fileID: 8926484042661615622}
      id: 0
      isStickyNote: 0
    - model: {fileID: 8926484042661615630}
